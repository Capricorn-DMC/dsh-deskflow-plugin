{
    "name":  "@local/deskflow",
    "version":  "1.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Deskflow keyboard/mouse sharing as a DeepSeek Harness plugin: LAN auto-discovery (UDP 40801), role negotiation UI, auto-connect via the bundled Deskflow backend",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "dependencies":  {

                     },
    "devDependencies":  {

                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            }
}